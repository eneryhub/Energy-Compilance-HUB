                      ? 'bg-emerald-100'
                      : result.success
                        ? 'bg-amber-100'
                        : 'bg-red-100'
                  )}>
                    {result.success && result.errors.length === 0 ? (
                      <CheckCircle2 className="w-8 h-8 text-emerald-600" />
                    ) : result.success ? (
