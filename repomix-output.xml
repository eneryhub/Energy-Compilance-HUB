              >
                <Download className="w-4 h-4" />
                Descargar PNG
              </Button>
              <Button variant="outline" onClick={() => setShowQrPreview(false)}>
                Cerrar
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>
    </div>
  )
}
