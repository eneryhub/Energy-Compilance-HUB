  -H "Authorization: Bearer $TOKEN" \\
  -H "X-API-Key: $API_KEY" \\
  -d '{"sensorId":"clp1234567890","value":45}'

# 4. Verificar que el sitio volvió a ser seguro
curl -s https://su-plataforma.com/api/sensors/site-safe \\
