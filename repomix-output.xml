# ── 9. SCADA ESPECÍFICO ────────────────────────────────────────────────────

Write-Header "9. SCADA — VERIFICACIÓN ESPECÍFICA"

Write-Section "Verificar modos de verificación"
$sw = [System.Diagnostics.Stopwatch]::StartNew()
try {
    $response = Invoke-WebRequest `
        -Uri "$BaseUrl/api/locations" `
