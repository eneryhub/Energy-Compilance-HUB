                <span className="text-sm font-medium text-slate-600">
                  {data.limits.permits.current} / {data.limits.permits.max}
                </span>
              </div>
            </CardHeader>
            <CardContent className="space-y-3">
              <Progress
                value={Math.min(data.limits.permits.percent, 100)}
