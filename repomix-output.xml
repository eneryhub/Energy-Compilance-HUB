      const status = prevValue >= sensor.thresholdCritical ? 'CRITICO' : prevValue >= sensor.thresholdWarning ? 'WARNING' : 'NORMAL'
      readingsData.push({
        sensorId: sensor.id,
        value: Math.round(prevValue * 10) / 10,
        status,
        timestamp: new Date(Date.now() - i * 3000), // 3 second intervals
