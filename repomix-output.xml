                  </div>
                  <p className="text-[10px] text-slate-500">Se genera con prefijo <code className="font-mono bg-slate-100 px-1 rounded">ech_live_</code></p>
                </div>
                <div className="p-3 rounded-lg bg-white border border-slate-200">
