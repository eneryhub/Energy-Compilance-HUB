'use client'

import { useMemo } from 'react'
import { getUser } from '@/lib/api'
import IncidentMonitor from '@/modules/erc/incident-monitor'

/**
 * ERCMonitor — Thin wrapper around the original IncidentMonitor from src/modules/erc/
