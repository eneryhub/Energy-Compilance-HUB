                            {err.row > 0 ? `F${err.row}` : '•'}
                          </span>
                          <span className="text-red-700">{err.message}</span>
                        </div>
                      ))}
                    </div>
                  </ScrollArea>
                </CardContent>
              </Card>
            )}

            {/* Actions */}
            <div className="flex items-center justify-center gap-3">
              <Button variant="outline" onClick={handleReset} className="gap-1.5">
                <RefreshCw className="w-4 h-4" />
                Nueva Importación
              </Button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  )
}
