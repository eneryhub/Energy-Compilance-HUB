              ['TEMPERATURA', '15 – 78 °C', '78 – 90 °C', '> 90 °C', 'Incinio, daño equipamiento'],
              ['GAS (%LEL)', '0 – 3.5%', '3.5 – 5.0%', '> 5.0%', 'Atmósfera explosiva (LEL)'],
              ['VOLTAJE', '180 – 240 V', '240 – 250 V', '> 250 V', 'Sobrecarga eléctrica, incendio'],
