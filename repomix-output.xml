            </DialogTitle>
            <DialogDescription>
              Registre una nueva ubicación para monitoreo SCADA y verificación de permisos.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 pt-2">
            {/* Name */}
            <div>
              <Label className="text-xs text-slate-600 mb-1.5 block">Nombre de la Ubicación *</Label>
