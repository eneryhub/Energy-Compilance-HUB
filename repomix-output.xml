            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 pt-2">
            {qrImageUrl && (
              <div className="flex justify-center p-4 rounded-xl bg-white border border-slate-200">
                <img
                  src={qrImageUrl}
                  alt="Código QR de ubicación"
