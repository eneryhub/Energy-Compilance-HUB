Write-Info "Endpoints de importación disponibles:"
$importEndpoints = @(
    "/api/v1/import/sensors",
    "/api/v1/import/permits"
)
foreach ($ep in $importEndpoints) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
