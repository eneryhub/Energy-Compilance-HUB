            </Badge>
            <Badge variant="outline" className="text-[10px] text-slate-400 border-slate-200">
              TypeScript
            </Badge>
            <Badge variant="outline" className="text-[10px] text-slate-400 border-slate-200">
              SQLite
            </Badge>
          </div>
