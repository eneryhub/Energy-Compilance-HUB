 */
export default function ERCMonitor() {
  const user = useMemo(() => getUser(), [])

  if (!user) {
    return (
      <div className="flex flex-col items-center justify-center py-20 text-slate-400">
        <p className="text-sm">No se encontró la sesión del usuario</p>
