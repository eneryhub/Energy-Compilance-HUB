generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                    String                @id @default(cuid())
  name                  String
  taxId                 String?               @unique
  email                 String                @unique
  phone                 String?
  address               String?
  logo                  String?
  subscriptionPlan      String                @default("starter")
  subscriptionStatus    String                @default("TRIAL")
  subscriptionExpiresAt DateTime?
  maxUsers              Int                   @default(10)
  maxPermitsPerMonth    Int                   @default(200)
  isActive              Boolean               @default(true)
  stripeCustomerId      String?               @unique
  stripeSubscriptionId  String?               @unique
  stripePriceId         String?
  billingEmail          String?
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  scadaDemoMode         Boolean               @default(true)
  billingCycle          String                @default("monthly")
  alertConfigs          AlertConfig[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  checklistItems        ChecklistItemConfig[]
  documents             HseDocument[]
  permits               Permit[]
  riskTypes             RiskTypeConfig[]
  sensors               Sensor[]
  invoices              SubscriptionInvoice[]
  systemAlerts          SystemAlert[]
  users                 User[]
  workLocations         WorkLocation[]
}

model User {
  id                String        @id @default(cuid())
  companyId         String
  email             String
  passwordHash      String?
  name              String
  role              String        @default("TECHNICIAN")
  isActive          Boolean       @default(true)
  lastLoginAt       DateTime?
  avatarUrl         String?
  phone             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  auditLogs         AuditLog[]
  reviewedDocuments HseDocument[] @relation("DocumentReviewer")
  documents         HseDocument[]
  permitsApproved   Permit[]      @relation("ApprovedBy")
  permitsCreated    Permit[]      @relation("CreatedBy")
  permitsRejected   Permit[]      @relation("RejectedBy")
  signatures        Signature[]
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([email, companyId])
}

model Permit {
  id                   String        @id @default(cuid())
  companyId            String
  permitNumber         String        @unique
  riskType             String
  status               String        @default("PENDING")
  safetyChecks         String        @default("{}")
  technicianName       String
  supervisorName       String
  workLocation         String
  workDescription      String
  rejectionReason      String?
  technicianSignature  String?
  supervisorSignature  String?
  photos               String?
  photosCount          Int           @default(0)
  createdById          String?
  createdByName        String?
  createdByRole        String?
  approvedById         String?
  approvedByName       String?
  rejectedById         String?
  rejectedByName       String?
  workLatitude         Float?
  workLongitude        Float?
  workRadius           Int           @default(100)
  workLocationId       String?
  locationSource       String        @default("manual")
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  approveJustification String?
  approvedBy           User?         @relation("ApprovedBy", fields: [approvedById], references: [id])
  company              Company       @relation(fields: [companyId], references: [id])
  createdBy            User?         @relation("CreatedBy", fields: [createdById], references: [id])
  rejectedBy           User?         @relation("RejectedBy", fields: [rejectedById], references: [id])
  workLocationRef      WorkLocation? @relation(fields: [workLocationId], references: [id])
  signatures           Signature[]

  @@index([companyId])
  @@index([status])
  @@index([createdById])
}

model WorkLocation {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  address            String?
  latitude           Float
  longitude          Float
  radiusMeters       Int      @default(100)
  verificationMethod String?
  verifiedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  beaconMajor        Int?
  beaconMinor        Int?
  beaconRssi         Int      @default(-70)
  beaconUuid         String?  @unique
  qrCodeData         String?
  qrCodeSecret       String?  @unique
  permits            Permit[]
  sensors            Sensor[]
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
}

model Signature {
  id                   String   @id @default(cuid())
  permitId             String
  signerType           String
  signerName           String
  signerId             String?
  signatureData        String
  signatureHash        String   @unique
  signedAt             DateTime @default(now())
  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?
  isWithinGeofence     Boolean?
  distanceToWorkMeters Float?
  deviceInfo           String?
  ipAddress            String?
  createdAt            DateTime @default(now())
  permit               Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  signer               User?    @relation(fields: [signerId], references: [id])

  @@index([permitId])
}

model HseDocument {
  id              String        @id @default(cuid())
  companyId       String
  userId          String?
  title           String
  documentType    String
  category        String
  criticality     String        @default("NORMAL")
  status          String        @default("ACTIVE")
  issueDate       DateTime?
  expiryDate      DateTime?
  holderName      String?
  description     String?
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  mimeType        String?
  aiExtractedData String?
  aiConfidence    Float?
  tags            String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  alertConfigs    AlertConfig[]
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy      User?         @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  assignedUser    User?         @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([expiryDate])
  @@index([criticality])
  @@index([status])
}

model RiskTypeConfig {
  id          String                @id @default(cuid())
  companyId   String
  key         String
  label       String
  color       String                @default("#6366f1")
  description String?
  icon        String                @default("AlertTriangle")
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  checklist   ChecklistItemConfig[]
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

model ChecklistItemConfig {
  id          String         @id @default(cuid())
  companyId   String
  riskTypeKey String
  itemKey     String
  label       String
  required    Boolean        @default(false)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  riskType    RiskTypeConfig @relation(fields: [riskTypeKey, companyId], references: [key, companyId], onDelete: Cascade)

  @@unique([companyId, riskTypeKey, itemKey])
  @@index([companyId])
  @@index([riskTypeKey])
}

model AlertConfig {
  id                String       @id @default(cuid())
  companyId         String
  documentId        String?
  name              String
  alertType         String
  triggerDaysBefore Int          @default(30)
  isActive          Boolean      @default(true)
  lastTriggeredAt   DateTime?
  message           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document          HseDocument? @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Sensor {
  id                String          @id @default(cuid())
  companyId         String
  locationId        String?
  name              String
  type              String
  currentValue      Float?
  unit              String
  thresholdCritical Float
  thresholdWarning  Float           @default(0)
  isSimulated       Boolean         @default(true)
  isActive          Boolean         @default(true)
  lastReadingAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location          WorkLocation?   @relation(fields: [locationId], references: [id])
  readings          SensorReading[]

  @@index([companyId])
  @@index([locationId])
  @@index([type])
  @@index([isActive])
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  value     Float
  status    String
  timestamp DateTime @default(now())
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, timestamp])
  @@index([sensorId])
}

model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  permissions String    @default("sensor:ingest")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  userId      String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([keyHash])
  @@index([isActive])
}

model SubscriptionInvoice {
  id              String   @id @default(cuid())
  companyId       String
  stripeInvoiceId String?  @unique
  amount          Float?
  currency        String   @default("usd")
  status          String   @default("paid")
  planName        String
  description     String?
  invoicePdfUrl   String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([paidAt])
}

model SystemAlert {
  id                String    @id @default(cuid())
  companyId         String
  type              String
  severity          String    @default("MEDIUM")
  title             String
  message           String
  metadata          String?
  isAcknowledged    Boolean   @default(false)
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime  @default(now())
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([severity])
  @@index([isAcknowledged])
  @@index([createdAt])
}

model KnowledgeBase {
  id              String   @id @default(cuid())
  errorCode       String   @unique
  category        String
  title           String
  rootCause       String
  appliedSolution String
  severity        String   @default("MEDIUM")
  referenceUrl    String?
  timesUsed       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([errorCode])
  @@index([severity])
}
